---
import { LANGS, detectLang, stripLang, langPath, type Lang } from '../i18n/translations';

const currentPath = Astro.url.pathname;
const currentLang: Lang = detectLang(currentPath);
const basePath = currentLang === 'fr' ? currentPath : stripLang(currentPath);
---

<div class="lang-switcher" id="lang-switcher">
  <button class="lang-btn" id="lang-btn" aria-label="Changer de langue / Change language" aria-expanded="false">
    <svg class="lang-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="2" y1="12" x2="22" y2="12"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
    <span class="lang-current">{LANGS.find(l => l.code === currentLang)?.flag}</span>
    <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
  </button>

  <div class="lang-dropdown" id="lang-dropdown" role="menu">
    {LANGS.map(lang => {
      const rawHref = langPath(lang.code, basePath);
      const href = basePath.startsWith('/vehicules/')
        ? `${rawHref}${rawHref.includes('?') ? '&' : '?'}lang=${lang.code}`
        : rawHref;
      const isActive = lang.code === currentLang;
      return (
        <a
          href={href}
          class={`lang-option ${isActive ? 'lang-option--active' : ''}`}
          role="menuitem"
          hreflang={lang.code}
        >
          <span class="lang-flag">{lang.flag}</span>
          <span class="lang-name">{lang.label}</span>
          {isActive && <span class="lang-check">✓</span>}
        </a>
      );
    })}
  </div>
</div>

<script is:inline>
(function() {
  const switcher  = document.getElementById('lang-switcher');
  const btn       = document.getElementById('lang-btn');
  const dropdown  = document.getElementById('lang-dropdown');
  if (!switcher || !btn || !dropdown) return;

  btn.addEventListener('click', function(e) {
    e.stopPropagation();
    const open = dropdown.classList.toggle('lang-dropdown--open');
    btn.setAttribute('aria-expanded', String(open));
  });

  document.addEventListener('click', function() {
    dropdown.classList.remove('lang-dropdown--open');
    btn.setAttribute('aria-expanded', 'false');
  });

  dropdown.addEventListener('click', function(e) { e.stopPropagation(); });
})();
</script>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-btn {
    display: flex; align-items: center; gap: .35rem;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 8px;
    padding: .4rem .65rem;
    cursor: pointer;
    color: var(--text-muted, #a0b0c0);
    font-size: .82rem;
    transition: background .15s, border-color .15s, color .15s;
  }
  .lang-btn:hover {
    background: rgba(77,212,200,.1);
    border-color: rgba(77,212,200,.3);
    color: #4dd4c8;
  }
  .lang-globe { opacity: .7; flex-shrink: 0; }
  .lang-current { font-size: 1rem; line-height: 1; }
  .lang-chevron { opacity: .6; transition: transform .15s; }

  .lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: #0f1e33;
    border: 1px solid rgba(77,212,200,.2);
    border-radius: 10px;
    padding: .4rem;
    min-width: 150px;
    box-shadow: 0 12px 32px rgba(0,0,0,.4);
    z-index: 1000;
    flex-direction: column;
    gap: 2px;
  }
  .lang-dropdown--open {
    display: flex;
  }

  .lang-option {
    display: flex; align-items: center; gap: .6rem;
    padding: .55rem .75rem;
    border-radius: 7px;
    text-decoration: none;
    color: var(--text-muted, #a0b0c0);
    font-size: .84rem;
    transition: background .12s, color .12s;
  }
  .lang-option:hover {
    background: rgba(77,212,200,.1);
    color: #4dd4c8;
  }
  .lang-option--active {
    color: #4dd4c8;
    font-weight: 600;
  }
  .lang-flag { font-size: 1.1rem; line-height: 1; }
  .lang-name { flex: 1; }
  .lang-check { color: #4dd4c8; font-size: .8rem; }
</style>
